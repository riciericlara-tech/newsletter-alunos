# Variáveis de ambiente. Na nuvem (Railway), defina estas no painel.
# Localmente, só precisa se quiser usar o Supabase em vez do arquivo data/db.json.

# --- Senha de acesso à plataforma (OBRIGATÓRIA na nuvem) ---
APP_PASSWORD=troque-por-uma-senha-forte

# --- Supabase (deixe em branco para usar armazenamento local data/db.json) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-service-role-key-aqui

# --- Porta (a Railway define sozinha; localmente o padrão é 3000) ---
# PORT=3000
